---
/**
 * Píldoras de filtro. Las usan el catálogo y los clasificados: las dos
 * secciones van sobre fondo claro y se ven igual, así que comparten componente
 * en vez de mantener dos copias del mismo CSS.
 *
 * Recibe los chips ya construidos porque cada sección cuenta lo suyo.
 * El estado activo lo maneja `src/scripts/filtro.ts` con `aria-pressed`.
 */
interface Chip {
  etiqueta: string;
  cuenta: number;
}

interface Props {
  chips: Chip[];
  etiquetaAria: string;
}

const { chips, etiquetaAria } = Astro.props;
---

<div class="filtros" role="group" aria-label={etiquetaAria}>
  {
    chips.map((c, i) => (
      <button
        type="button"
        class="chip"
        data-filtro={c.etiqueta}
        aria-pressed={i === 0 ? 'true' : 'false'}
      >
        {c.etiqueta} <span class="cuenta">{c.cuenta}</span>
      </button>
    ))
  }
</div>

<style>
  .filtros {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }
  .chip {
    font-family: var(--font-subhead);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    padding: 9px 16px;
    border-radius: var(--radius-pill);
    cursor: pointer;
    border: 1px solid var(--li-gray-200);
    background: var(--li-white);
    color: var(--li-navy);
    display: flex;
    align-items: center;
    gap: var(--space-2);
    transition:
      background var(--duration-fast) var(--ease-standard),
      border-color var(--duration-fast) var(--ease-standard),
      color var(--duration-fast) var(--ease-standard);
  }
  .chip:hover {
    border-color: var(--li-navy);
  }
  /* El chip activo se marca con aria-pressed, así el estado visual
     y el estado accesible no pueden desincronizarse. */
  .chip[aria-pressed='true'] {
    background: var(--li-navy);
    border-color: var(--li-navy);
    color: var(--li-white);
  }
  .cuenta {
    opacity: 0.65;
    font-weight: var(--weight-regular);
  }
</style>
