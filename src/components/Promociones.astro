---
/**
 * Descuentos y beneficios que ofrecen los negocios de la comunidad.
 *
 * A diferencia del catálogo y de los clasificados, esta sección **caduca**: una
 * promoción vencida no se enseña aunque su archivo siga en el repositorio. El
 * cron la retira, pero el sitio se reconstruye cada tanto y entre medias podría
 * quedar una a la vista; el filtro de aquí lo impide.
 */
import { SITIO } from '../data/sitio';
import {
  estaVigente,
  ordenarPromociones,
  fechaLegible,
  diasRestantes,
  type Promocion,
} from '../data/promocion';
import { telHref } from '../data/negocio';

interface Props {
  promociones: Promocion[];
}

const { promociones } = Astro.props;

/*
 * Todo lo que compara se resuelve AQUÍ, no en la plantilla.
 *
 * No es solo estilo: el analizador de Astro lee `<=` como la apertura de un
 * fragmento `<>` y rompe el archivo entero —incluido el <style>, que pasa a
 * leerse como TypeScript—. Ocurre igual dentro del cuerpo de un `.map()`,
 * así que la plantilla se queda sin una sola comparación.
 */
const vigentes = ordenarPromociones(promociones.filter((p) => estaVigente(p))).map((p) => {
  const dias = diasRestantes(p.data.hasta);
  let cuanto: string;
  if (dias <= 0) cuanto = 'Último día';
  else if (dias === 1) cuanto = 'Queda 1 día';
  else if (dias <= 7) cuanto = `Quedan ${dias} días`;
  else cuanto = `Hasta el ${fechaLegible(p.data.hasta)}`;
  return { d: p.data, cuanto, urgente: String(dias <= 3) };
});
---

<section id="promociones">
  <div class="li-container">
    <div class="encabezado">
      <p class="li-eyebrow">Entre familias</p>
      <h2>Promociones</h2>
      <p class="entrada">
        Descuentos y beneficios de los negocios de la comunidad FLI.
        <a href={SITIO.promocionUrl}>Publica la tuya</a>.
      </p>
    </div>

    {
      vigentes.length > 0 ? (
        <div class="rejilla">
          {vigentes.map((v) => (
            <article class="tarjeta">
              <p class="negocio">{v.d.negocio}</p>
              <h3>{v.d.titulo}</h3>
              <p class="desc">{v.d.desc}</p>
              {v.d.condiciones && <p class="condiciones">{v.d.condiciones}</p>}
              <div class="pie">
                <span class="vigencia" data-urgente={v.urgente}>{v.cuanto}</span>
                <a class="contactar" href={telHref(v.d.telefono)}>Contactar</a>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <p class="proximamente">
          Todavía no hay promociones activas.
          <a href={SITIO.promocionUrl}>Publica la de tu negocio</a>.
        </p>
      )
    }
  </div>
</section>

<style>
  section {
    background: var(--surface-page);
    padding-block: var(--space-20);
  }

  .encabezado {
    margin-bottom: 30px;
  }
  .encabezado :global(.li-eyebrow) {
    display: block;
    margin: 0 0 var(--space-3);
  }
  h2 {
    font-family: var(--font-display);
    /* "PROMOCIONES" es una palabra larga en una tipografía muy ancha y no se
       puede partir: a 30px fijos desborda una pantalla de 320px. */
    font-size: clamp(20px, 6.2vw, var(--text-2xl));
    letter-spacing: var(--tracking-display);
    text-transform: uppercase;
    color: var(--text-heading);
    margin: 0 0 var(--space-3);
  }
  .entrada {
    margin: 0;
    font-size: var(--text-base);
    color: var(--text-body);
    max-width: 60ch;
  }
  .entrada a {
    color: var(--text-link);
  }

  .rejilla {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-6);
  }
  .tarjeta {
    display: flex;
    flex-direction: column;
    padding: var(--space-6);
    background: var(--surface-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-md);
  }
  .negocio {
    margin: 0 0 var(--space-2);
    font-family: var(--font-subhead);
    font-size: var(--text-3xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--li-red);
  }
  h3 {
    margin: 0 0 var(--space-3);
    font-family: var(--font-subhead);
    font-size: var(--text-md);
    color: var(--text-heading);
  }
  .desc {
    margin: 0 0 var(--space-3);
    font-size: var(--text-sm);
    color: var(--text-body);
  }
  .condiciones {
    margin: 0 0 var(--space-4);
    font-size: var(--text-xs);
    /* Gris oscuro y no --text-muted: sobre blanco ese gris da 3.55 y no llega
       a AA. Las condiciones son letra pequeña, no letra ilegible. */
    color: var(--li-gray-600);
  }
  .pie {
    margin-top: auto;
    padding-top: var(--space-4);
    border-top: 1px solid var(--border-subtle);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }
  .vigencia {
    font-family: var(--font-subhead);
    font-size: var(--text-3xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--li-gray-600);
  }
  /* Lo que se acaba se marca en rojo: es la información que hace actuar. */
  .vigencia[data-urgente='true'] {
    color: var(--li-red);
  }
  .contactar {
    font-family: var(--font-subhead);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--text-link);
    text-decoration: none;
    white-space: nowrap;
  }

  .proximamente {
    margin: 0;
    padding: var(--space-16) var(--space-6);
    text-align: center;
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius-card);
    background: var(--surface-subtle);
    font-family: var(--font-subhead);
    font-size: var(--text-md);
    font-weight: var(--weight-semibold);
    color: var(--li-gray-600);
  }
  .proximamente a {
    color: var(--text-link);
  }

  @media (max-width: 900px) {
    .rejilla {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 600px) {
    section {
      padding-block: var(--space-12);
    }
    .rejilla {
      grid-template-columns: 1fr;
    }
    .proximamente {
      padding: var(--space-12) var(--space-5);
      font-size: var(--text-base);
    }
  }
</style>
