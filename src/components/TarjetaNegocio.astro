---
import { Image } from 'astro:assets';
import { anchoSeguro, type Negocio } from '../data/negocio';
import FlechaEnlace from './FlechaEnlace.astro';

interface Props {
  negocio: Negocio;
}

const { negocio } = Astro.props;
const { nombre, categoria, descripcion, familia, foto } = negocio.data;
const href = `/negocio/${negocio.id}/`;

// 2x del recuadro de 400x170 de la tarjeta (ratio 2.35:1).
const ancho = foto ? anchoSeguro(foto, 800) : 0;

/*
 * Respaldo cuando la ficha no trae foto.
 *
 * Muchas familias se inscriben sin una, y exigirla obligaba a inventarse algo o
 * a dejarlas fuera. La inicial sobre el navy del sistema ocupa el mismo hueco y
 * el mismo 2.35:1, así que la rejilla no se descuadra al mezclar tarjetas con
 * foto y sin ella, que es lo que de verdad se nota.
 */
const inicial = nombre.trim().charAt(0).toUpperCase();
---

<article class="tarjeta" data-negocio data-categoria={categoria}>
  <a class="foto" href={href} data-abrir={negocio.id}>
    {
      foto ? (
        <Image
          src={foto}
          alt={`Foto de ${nombre}`}
          width={ancho}
          height={Math.round(ancho / 2.35)}
          loading="lazy"
        />
      ) : (
        <span class="sin-foto" aria-hidden="true">{inicial}</span>
      )
    }
  </a>

  <div class="cuerpo">
    <p class="categoria">{categoria}</p>
    <h3 class="nombre">{nombre}</h3>
    <p class="descripcion">{descripcion}</p>

    <div class="pie">
      <span class="familia">{familia}</span>
      <a class="contactar" href={href} data-abrir={negocio.id}>
        Contactar <FlechaEnlace />
        <span class="li-sr-only">a {nombre}</span>
      </a>
    </div>
  </div>
</article>

<style>
  /* El respaldo ocupa exactamente el hueco de la foto: mismo ratio y mismo
     recorte, para que una rejilla con unas y otras no se vea rota. */
  .sin-foto {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 2.35 / 1;
    background: var(--surface-navy);
    color: var(--li-white);
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    letter-spacing: var(--tracking-display);
    user-select: none;
  }

  .tarjeta {
    background: var(--surface-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-card);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-md);
    transition:
      transform var(--duration-base) var(--ease-standard),
      box-shadow var(--duration-base) var(--ease-standard);
  }
  .tarjeta:hover {
    transform: var(--motion-lift);
    box-shadow: var(--shadow-lg);
  }
  .foto {
    display: block;
    height: 170px;
    background: var(--surface-subtle);
    overflow: hidden;
  }
  .foto :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .cuerpo {
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    flex: 1;
  }
  .categoria {
    margin: 0;
    font-family: var(--font-subhead);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--li-red);
    font-weight: var(--weight-semibold);
  }
  .nombre {
    font-family: var(--font-subhead);
    font-weight: var(--weight-semibold);
    font-size: var(--text-lg);
    color: var(--text-heading);
    letter-spacing: 0;
    line-height: var(--leading-snug);
    margin: 0;
  }
  /* La descripción admite hasta 1.200 caracteres porque la ficha tiene sitio
     para ellos; la tarjeta no. Se recorta por LÍNEAS y no por caracteres: así
     todas las tarjetas de una fila miden lo mismo, y el corte se lee como «hay
     más al entrar» en vez de como un texto partido a mitad de palabra.

     El `max-height` no sobra: `line-clamp` no degrada solo. Si un navegador lo
     ignorara, sin él la tarjeta crecería y estiraría la fila entera; con él el
     peor caso es un texto cortado sin los puntos suspensivos. Son 3 líneas del
     mismo `line-height` que declara la regla. */
  .descripcion {
    margin: 0;
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--text-body);
    flex: 1;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    overflow: hidden;
    max-height: calc(var(--text-sm) * var(--leading-normal) * 3);
  }
  .pie {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
    margin-top: 6px;
    padding-top: var(--space-3);
    border-top: 1px solid var(--border-subtle);
  }
  .familia {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }
  .contactar {
    text-decoration: none;
    font-family: var(--font-subhead);
    font-weight: var(--weight-semibold);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--text-link);
    white-space: nowrap;
  }
</style>
