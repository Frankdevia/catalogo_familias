---
import { Image } from 'astro:assets';
import { SITIO } from '../data/sitio';
import fondo from '../assets/photos/cta-plano-arquitectura.webp';
---

<section class="cta">
  <Image
    class="fondo"
    src={fondo}
    alt=""
    aria-hidden="true"
    widths={[768, 1024, 1536]}
    sizes="100vw"
    loading="lazy"
  />
  <div class="velo" aria-hidden="true"></div>

  <div class="contenido li-container">
    <p class="script">¿tu familia tiene un negocio?</p>
    <h2>Inscríbelo en el catálogo</h2>
    <p class="entrada">
      Llega a toda la comunidad del Liceo Inglés. La inscripción es gratuita para
      las familias del colegio.
    </p>
    <a class="li-btn" href={SITIO.signupUrl}>Inscribe tu negocio</a>
  </div>
</section>

<style>
  .cta {
    position: relative;
    min-height: 380px;
    display: flex;
    align-items: center;
  }
  .fondo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .velo {
    position: absolute;
    inset: 0;
    /*
     * El degradado anterior servía para una foto oscura. El plano de
     * arquitectura es casi todo blanco, y sobre blanco esas opacidades dejaban
     * el párrafo en 3.53:1 y el rótulo amarillo en 2.30:1 — muy por debajo del
     * 4.5:1 de WCAG AA. A 768px llegaba a caer a 2.00:1.
     *
     * Misma solución que en el hero: la parada usa `max(700px, 48%)` en vez de
     * un porcentaje solo, porque el texto mide 560px + gutter y en pantallas
     * medianas la parte opaca tiene que cubrir esos píxeles concretos.
     *
     * El extremo derecho no baja de 0.38: con una foto clara detrás, abrirlo
     * más deja un borde casi blanco justo encima del footer navy, y la costura
     * entre los dos canta. A 0.38 el dibujo se sigue viendo.
     */
    background: linear-gradient(
      90deg,
      rgba(35, 45, 117, 0.94) 0%,
      rgba(35, 45, 117, 0.88) max(700px, 48%),
      rgba(35, 45, 117, 0.55) 80%,
      rgba(35, 45, 117, 0.38) 100%
    );
  }
  .contenido {
    position: relative;
    padding-block: 72px;
  }
  .contenido > * {
    max-width: 560px;
  }
  .script {
    font-family: var(--font-script);
    font-size: var(--text-2xl);
    color: var(--li-yellow);
    margin: 0 0 var(--space-2);
  }
  h2 {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    letter-spacing: var(--tracking-display);
    text-transform: uppercase;
    color: var(--li-white);
    margin: 0 0 14px;
  }
  .entrada {
    margin: 0 0 26px;
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--li-white);
  }
  .cta :global(:focus-visible) {
    outline-color: var(--li-yellow);
  }

  @media (max-width: 760px) {
    .contenido {
    position: relative;
      padding-block: var(--space-12);
    }
    .velo {
      background: linear-gradient(
        180deg,
        rgba(35, 45, 117, 0.84) 0%,
        rgba(35, 45, 117, 0.9) 100%
      );
    }
  }
</style>
