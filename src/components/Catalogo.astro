---
import { getImage } from 'astro:assets';
import Filtros from './Filtros.astro';
import TarjetaNegocio from './TarjetaNegocio.astro';
import ModalNegocio from './ModalNegocio.astro';
import VisorFoto from './VisorFoto.astro';
import { CATEGORIAS, TODOS } from '../data/categorias';
import { telHref, webHref, instagramHref, type Negocio } from '../data/negocio';
import { encuadreDe, anchoUtil } from '../lib/encuadre';
import type { NegocioModal } from '../scripts/tipos';

interface Props {
  negocios: Negocio[];
}

const { negocios } = Astro.props;

// Se muestran TODAS las categorías, también las que aún no tienen negocios: el
// chip con un 0 le dice a la familia que esa categoría existe y que puede
// inscribir el suyo ahí. Al pulsarlo sale el mensaje de "todavía no hay
// negocios en esta categoría", así que no es un callejón sin salida.
const chips = [
  { etiqueta: TODOS, cuenta: negocios.length },
  ...CATEGORIAS.map((c) => ({
    etiqueta: c as string,
    cuenta: negocios.filter((n) => n.data.categoria === c).length,
  })),
];

// El modal se rellena en el cliente, así que las fotos se optimizan aquí
// (2x de los 520x200 que mide la cabecera del diálogo).
const datos: NegocioModal[] = await Promise.all(
  negocios.map(async (n) => {
    // 2x de los 520x200 del diálogo, sin pasarse del original (ratio 2.6:1).
    // Solo se optimiza si la ficha trae foto: muchas se inscriben sin ella.
    let foto: string | undefined;
    let encuadre: Awaited<ReturnType<typeof encuadreDe>> | null = null;
    let medidas: { ancho: number; alto: number } | null = null;
    let fotoGrande: string | undefined;
    if (n.data.foto) {
      // Un logo se muestra entero, así que el recorte no puede cocinarse en la
      // imagen: se pide a su proporción natural y el encaje lo aplica el CSS.
      encuadre = await encuadreDe(n.data.foto, n.data.foto_completa === true);

      // 800x340, LOS MISMOS que pide `TarjetaNegocio.astro`, aunque la cabecera
      // del diálogo mida 520x200 y admitiría más.
      //
      // Pedir su medida ideal generaba un segundo juego de fotos casi idéntico:
      // de 24 fichas, tarjeta y modal compartían UNA sola URL, y por casualidad.
      // Las otras 23 eran 1,35 MB que existían solo para el diálogo, y abrir una
      // tarjeta descargaba de nuevo la foto que ya estaba en pantalla —entre 121
      // y 495 ms mirando el negocio anterior—.
      //
      // Con las mismas medidas, Astro emite un único archivo y el navegador lo
      // sirve de su caché: ya está descargado y decodificado porque se está
      // viendo en la rejilla. El precio es que en pantallas densas el diálogo
      // recibe 800px donde le cabrían 1040; no se ve, y la apertura es
      // instantánea.
      const ancho = anchoUtil(n.data.foto, encuadre, 800, 340);
      const generada = await getImage({
        src: n.data.foto,
        width: ancho,
        height: Math.round(ancho / (n.data.foto.width / n.data.foto.height)),
        format: 'webp',
      });
      foto = generada.src;
      medidas = { ancho: Number(generada.attributes.width), alto: Number(generada.attributes.height) };

      // La misma foto a 1600px para el visor. No la descarga nadie hasta que
      // se pulsa: solo viaja la URL.
      fotoGrande = (
        await getImage({
          src: n.data.foto,
          width: Math.min(1600, n.data.foto.width),
          format: 'webp',
        })
      ).src;
    }
    return {
      slug: n.id,
      nombre: n.data.nombre,
      categoria: n.data.categoria,
      familia: n.data.familia,
      descripcion: n.data.descripcion,
      foto,
      encaje: encuadre?.encaje,
      fondo: encuadre?.fondo,
      fotoAncho: medidas?.ancho,
      fotoAlto: medidas?.alto,
      fotoGrande,
      telefono: n.data.telefono,
      telHref: telHref(n.data.telefono),
      direccion: n.data.direccion,
      web: n.data.web,
      webHref: n.data.web ? webHref(n.data.web) : undefined,
      instagram: n.data.instagram,
      instagramHref: n.data.instagram ? instagramHref(n.data.instagram) : undefined,
      facebook: n.data.facebook,
      ficha: `/negocio/${n.id}/`,
    };
  }),
);

// Escapa "<" para que ningún dato pueda cerrar el <script> antes de tiempo.
const datosJson = JSON.stringify(datos).replace(/</g, '\\u003c');
---

<section id="catalogo">
  <div class="li-container">
    <div class="encabezado">
      <div>
        <p class="li-eyebrow">Familias FLI</p>
        <h2>Catálogo de empresas</h2>
        <p class="entrada">
          Todo lo que ofrecen las familias de la Fundación Liceo Inglés, a un clic.
        </p>
      </div>
      <div class="herramientas">
        {/* Un `type="search"` de verdad: el navegador le pone su «x» para
            limpiar y el teclado del móvil muestra la lupa en vez de Intro. */}
        <label class="buscador">
          <span class="li-sr-only">Buscar por nombre o descripción</span>
          <svg class="lupa" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
            <circle cx="9" cy="9" r="6" fill="none" stroke="currentColor" stroke-width="2" />
            <line x1="13.5" y1="13.5" x2="18" y2="18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
          <input
            id="catalogo-busca"
            type="search"
            placeholder="Buscar un negocio…"
            autocomplete="off"
            enterkeyhint="search"
          />
        </label>
        <Filtros chips={chips} etiquetaAria="Filtrar por categoría" />
      </div>
    </div>

    <p id="catalogo-conteo" class="li-sr-only" role="status" aria-live="polite">
      {negocios.length} negocios
    </p>

    <div class="rejilla">
      {negocios.map((negocio) => <TarjetaNegocio negocio={negocio} />)}
    </div>

    {/* El mismo hueco sirve para los dos vacíos posibles; el script marca cuál
        toca con `data-motivo`, porque «no hay nada en esta categoría» y «no
        encontré eso» piden respuestas distintas. */}
    <p id="catalogo-vacio" class="vacio" hidden data-motivo="categoria">
      <span class="por-categoria">Todavía no hay negocios en esta categoría.</span>
      <span class="por-busqueda">
        No encontramos ningún negocio con «<span data-termino></span>».
        Prueba con menos palabras.
      </span>
    </p>
  </div>
</section>

<ModalNegocio />
<VisorFoto />

<script id="negocios-datos" type="application/json" is:inline set:html={datosJson} />

<script>
  import '../scripts/catalogo.ts';
</script>

<style>
  section {
    padding-block: var(--space-20);
  }
  .encabezado {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-6);
    flex-wrap: wrap;
    margin-bottom: 30px;
  }
  /* Buscador y categorías van juntos y alineados a la derecha: son las dos
     maneras de reducir la lista y se leen como un solo bloque de controles. */
  .herramientas {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--space-3);
  }

  .buscador {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0 var(--space-3);
    width: 260px;
    max-width: 100%;
    background: var(--surface-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-pill);
    transition: border-color var(--duration-base) var(--ease-standard);
  }
  .buscador:focus-within {
    border-color: var(--li-navy);
  }
  .lupa {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    /* Gris oscuro y no --text-muted: el icono es lo que dice para qué sirve
       el campo cuando el marcador de posición ya no está. */
    color: var(--li-gray-600);
  }
  .buscador input {
    flex: 1;
    min-width: 0;
    border: none;
    background: none;
    padding: 10px 0;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--text-body);
  }
  .buscador input:focus {
    outline: none;
  }
  .buscador input::placeholder {
    color: var(--li-gray-600);
  }
  /* Safari dibuja su propia lupa dentro del campo; sobra, ya hay una. */
  .buscador input::-webkit-search-decoration {
    appearance: none;
  }

  /* Solo se enseña el mensaje que corresponde. */
  .vacio .por-busqueda,
  .vacio[data-motivo='busqueda'] .por-categoria {
    display: none;
  }
  .vacio[data-motivo='busqueda'] .por-busqueda {
    display: inline;
  }
  .encabezado :global(.li-eyebrow) {
    display: block;
    margin: 0 0 var(--space-3);
  }
  h2 {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    letter-spacing: var(--tracking-display);
    text-transform: uppercase;
    color: var(--text-heading);
    margin: 0 0 var(--space-3);
  }
  .entrada {
    margin: 0;
    font-size: var(--text-base);
    color: var(--text-body);
    max-width: 60ch;
  }

  .rejilla {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-6);
  }

  .vacio {
    margin: var(--space-10) 0 0;
    text-align: center;
    font-size: var(--text-base);
    /* Ahora que se muestran las categorías vacías, este mensaje deja de ser un
       caso raro y se ve a diario. --text-muted sobre blanco da 3.55 y no llega
       a AA; --li-gray-600 sube a 5.68 sin salirse del sistema. */
    color: var(--li-gray-600);
  }
  .nota {
    margin: var(--space-6) 0 0;
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  @media (max-width: 900px) {
    .rejilla {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    /* En cuanto el encabezado se apila, el buscador ocupa el ancho: alineado a
       la derecha y estrecho se vería como un adorno perdido. */
    .herramientas {
      align-items: stretch;
      width: 100%;
    }
    .buscador {
      width: 100%;
    }
  }
  @media (max-width: 600px) {
    section {
      padding-block: var(--space-12);
    }
    .rejilla {
      grid-template-columns: 1fr;
    }
  }
</style>
