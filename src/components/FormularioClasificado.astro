---
import { CATEGORIAS_CLASIFICADOS } from '../data/clasificados';
import { SITIO } from '../data/sitio';
import { LIMITES, PATRON_TELEFONO, CAMPO_TRAMPA } from '../data/registro';
import Consentimiento from './Consentimiento.astro';

interface Props {
  /** URL del webhook de n8n. Vacía = el formulario se muestra deshabilitado. */
  endpoint: string;
}

const { endpoint } = Astro.props;

/** El texto del anuncio, más corto que la descripción de un negocio. */
const MAX_DESC = 280;
---

<form id="form-clasificado" data-endpoint={endpoint} novalidate>
  {
    !endpoint && (
      <p class="aviso aviso--error">
        El formulario todavía no está conectado. Escríbenos a{' '}
        <a href={`mailto:${SITIO.contactEmail}`}>{SITIO.contactEmail}</a>.
      </p>
    )
  }

  <noscript>
    <p class="aviso aviso--error">
      Este formulario necesita JavaScript. Si no puedes activarlo, mándanos tu
      anuncio a{' '}
      <a href={`mailto:${SITIO.contactEmail}`}>{SITIO.contactEmail}</a>.
    </p>
  </noscript>

  <fieldset>
    <legend>1. Verifica tu familia</legend>
    <p class="ayuda-bloque">
      Solo para confirmar que perteneces a la comunidad. <strong>Los nombres de
      tus estudiantes y tu nombre no se publican.</strong>
    </p>

    <div class="campo">
      <label for="estudiantes">Nombres de tus estudiantes y su grado</label>
      <input
        id="estudiantes"
        name="estudiantes"
        type="text"
        required
        maxlength={LIMITES.estudiantes.max}
        autocomplete="off"
        placeholder="Valeria Gómez 11B, Antonia Ruiz 7A"
        aria-describedby="ayuda-estudiantes"
      />
      <p id="ayuda-estudiantes" class="ayuda">
        (Se usa para validar la identidad de quien llena el formulario.)
      </p>
      <p class="error" data-error-de="estudiantes" hidden></p>
    </div>

    <div class="campo">
      <label for="acudiente_nombre">Nombre del padre, madre o acudiente</label>
      <input
        id="acudiente_nombre"
        name="acudiente_nombre"
        type="text"
        required
        maxlength={LIMITES.acudienteNombre.max}
        autocomplete="name"
      />
      <p class="error" data-error-de="acudiente_nombre" hidden></p>
    </div>
  </fieldset>

  <fieldset>
    <legend>2. Tu anuncio</legend>
    <p class="ayuda-bloque">Esto es lo que verá la comunidad en el catálogo.</p>

    <div class="campo">
      <label for="cat">¿Qué quieres publicar?</label>
      <select id="cat" name="cat" required>
        <option value="">Elige una…</option>
        {CATEGORIAS_CLASIFICADOS.map((c) => <option value={c}>{c}</option>)}
      </select>
      <p class="error" data-error-de="cat" hidden></p>
    </div>

    <div class="campo">
      <label for="desc">Descripción</label>
      <textarea
        id="desc"
        name="desc"
        required
        rows="4"
        maxlength={MAX_DESC}
        aria-describedby="contador-desc"
      ></textarea>
      <p id="contador-desc" class="ayuda contador" aria-live="polite">
        0 de {MAX_DESC} caracteres
      </p>
      <p class="error" data-error-de="desc" hidden></p>
    </div>

    <div class="fila">
      <div class="campo">
        <label for="phone">Teléfono de contacto</label>
        <input
          id="phone"
          name="phone"
          type="tel"
          required
          pattern={PATRON_TELEFONO}
          inputmode="tel"
          autocomplete="tel"
        />
        <p class="error" data-error-de="phone" hidden></p>
      </div>

      <div class="campo">
        <label for="email">Correo de contacto</label>
        <input
          id="email"
          name="email"
          type="email"
          required
          autocomplete="email"
        />
        <p class="error" data-error-de="email" hidden></p>
      </div>
    </div>
  </fieldset>

  <Consentimiento
    aviso="Entiendo que <strong>el teléfono y el correo que escribí arriba se publicarán en un sitio web público</strong>, visible para cualquiera, y autorizo su publicación junto con el texto de mi anuncio."
  />

  {/* Campo trampa: oculto para personas, irresistible para bots. */}
  <div class="trampa" aria-hidden="true">
    <label for={CAMPO_TRAMPA}>No llenes este campo</label>
    <input id={CAMPO_TRAMPA} name={CAMPO_TRAMPA} type="text" tabindex="-1" autocomplete="off" />
  </div>

  <div class="acciones">
    <button type="submit" class="li-btn" disabled={!endpoint}>Enviar anuncio</button>
    <p class="ayuda">Revisamos cada anuncio antes de publicarlo.</p>
  </div>

  <p class="aviso" data-estado role="status" aria-live="polite" hidden></p>
</form>

<div id="exito" class="exito" hidden>
  <p class="li-eyebrow">Anuncio enviado</p>
  <h2>Gracias, ya lo recibimos</h2>
  <p>
    Lo revisaremos y te escribiremos al correo que nos diste cuando esté
    publicado en la sección de clasificados.
  </p>
  <a class="li-btn" href="/#clasificados">Volver a los clasificados</a>
</div>

<style>
  form {
    display: grid;
    gap: var(--space-10);
    max-width: 720px;
  }

  fieldset {
    border: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-5);
  }
  legend {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    letter-spacing: var(--tracking-display);
    text-transform: uppercase;
    color: var(--text-heading);
    padding: 0;
    margin-bottom: var(--space-2);
  }
  .ayuda-bloque {
    margin: 0;
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--text-body);
    background: var(--surface-subtle);
    border-left: 3px solid var(--li-yellow);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-xs);
  }

  .fila {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5);
  }

  .campo {
    display: grid;
    gap: 6px;
    align-content: start;
  }
  label {
    font-family: var(--font-subhead);
    font-weight: var(--weight-semibold);
    font-size: var(--text-sm);
    color: var(--text-heading);
  }

  input[type='text'],
  input[type='tel'],
  input[type='email'],
  select,
  textarea {
    font-family: var(--font-body);
    font-size: var(--text-base);
    color: var(--text-body);
    background: var(--surface-card);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-control);
    padding: 11px 14px;
    width: 100%;
    transition: border-color var(--duration-fast) var(--ease-standard);
  }
  textarea {
    resize: vertical;
    line-height: var(--leading-normal);
  }
  input:hover,
  select:hover,
  textarea:hover {
    border-color: var(--li-navy);
  }
  [aria-invalid='true'] {
    border-color: var(--li-red);
  }

  .ayuda {
    margin: 0;
    font-size: var(--text-xs);
    line-height: var(--leading-normal);
    color: var(--text-muted);
  }
  .contador {
    justify-self: end;
  }
  .error {
    margin: 0;
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    color: var(--li-red);
  }

  /* Fuera de la vista pero no `display:none`: algunos bots ignoran lo que
     está oculto de esa forma. */
  .trampa {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .acciones {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    flex-wrap: wrap;
  }
  .acciones button[disabled] {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .aviso {
    margin: 0;
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    padding: var(--space-4);
    border-radius: var(--radius-md);
    background: var(--surface-subtle);
    color: var(--text-body);
  }
  .aviso--error {
    background: var(--surface-brand-soft);
    color: var(--li-red-700);
    border: 1px solid var(--li-red-300);
  }

  .exito {
    max-width: 560px;
  }
  .exito h2 {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    letter-spacing: var(--tracking-display);
    text-transform: uppercase;
    color: var(--text-heading);
    margin: var(--space-3) 0 var(--space-4);
  }
  .exito p:last-of-type {
    margin-bottom: var(--space-8);
  }

  @media (max-width: 640px) {
    .fila {
      grid-template-columns: 1fr;
    }
  }
</style>
