---
import { FORMAS_DE_APOYAR } from '../data/sitio';
---

<section id="apoyar">
  <div class="rejilla li-container">
    <div class="intro">
      <p class="li-eyebrow">Comunidad FLI</p>
      <h2>Cómo apoyar, más allá de comprar</h2>
      <p class="script">apoyarnos entre todos, we love it!</p>
    </div>

    <ol class="formas">
      {
        FORMAS_DE_APOYAR.map((forma) => (
          <li>
            <span class="numero" aria-hidden="true">
              {forma.n}
            </span>
            <div>
              <h3>{forma.titulo}</h3>
              <p>{forma.cuerpo}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  section {
    background: var(--surface-subtle);
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
  }
  .rejilla {
    padding-block: var(--space-20);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    gap: 56px;
    align-items: start;
  }
  .intro :global(.li-eyebrow) {
    display: block;
    margin: 0 0 var(--space-3);
  }
  h2 {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    letter-spacing: var(--tracking-display);
    text-transform: uppercase;
    color: var(--text-heading);
    margin: 0 0 14px;
    line-height: var(--leading-tight);
  }
  .script {
    font-family: var(--font-script);
    font-size: var(--text-2xl);
    color: var(--li-red);
    margin: 0;
  }

  .formas {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: none;
  }
  .formas li {
    display: flex;
    gap: var(--space-5);
    align-items: baseline;
    padding: 18px 0;
    border-bottom: 1px solid var(--border-subtle);
  }
  .numero {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    color: var(--li-red);
    letter-spacing: var(--tracking-display);
    min-width: 44px;
    flex-shrink: 0;
  }
  .formas h3 {
    font-family: var(--font-subhead);
    font-weight: var(--weight-semibold);
    font-size: var(--text-base);
    color: var(--text-heading);
    letter-spacing: 0;
    margin: 0 0 2px;
  }
  .formas p {
    margin: 0;
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--text-body);
  }

  @media (max-width: 860px) {
    .rejilla {
      grid-template-columns: 1fr;
      gap: var(--space-8);
      padding-block: var(--space-16);
    }
  }
</style>
