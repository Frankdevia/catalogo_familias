---
/**
 * La autorización de tratamiento de datos, para los tres formularios.
 *
 * Vive en un solo sitio a propósito. Es texto legal: la primera corrección que
 * se hiciera sobre tres copias dejaría dos desactualizadas, y nadie se
 * enteraría hasta que importara. Si hay que cambiarlo, se cambia aquí.
 *
 * `aviso` es para lo que este texto NO dice y en algún formulario sí hay que
 * decir —en clasificados, que el teléfono y el correo se publican tal cual—.
 * Va delante, que es donde se lee.
 */
interface Props {
  /** Advertencia concreta de este formulario, en HTML. Opcional. */
  aviso?: string;
}

const { aviso } = Astro.props;
---

<div class="campo campo--consentimiento">
  <label class="consentimiento">
    <input id="consentimiento" name="consentimiento" type="checkbox" required />
    <span>
      {aviso && <p class="aviso" set:html={aviso} />}
      <p>
        He leído y acepto la
        {/* «He leído» tiene que poder cumplirse: la política vive en
            /privacidad y se abre en otra pestaña para no perder el formulario
            a medio llenar. El enlace está dentro de la etiqueta pero no marca
            la casilla —un elemento interactivo dentro de un <label> no activa
            el control—, así que consultar la política no da el consentimiento
            de paso. */}
        <a href="/privacidad" target="_blank" rel="noopener">
          Política de Tratamiento de Datos Personales
        </a> de la Fundación Liceo Inglés de Pereira (NIT 891.412.970-0) y, de
        manera libre, previa, expresa e informada, autorizo el tratamiento de
        mis datos personales y los de mi negocio o actividad comercial
        suministrados en este formulario, con el fin de publicarlos en el
        directorio de emprendimientos y servicios (marketplace) de la comunidad
        educativa disponible en la página web del Colegio.
      </p>
      <p>
        Declaro conocer que dicho directorio es un espacio público, por lo que
        la información allí publicada será visible para cualquier visitante de
        la página web sin restricción de acceso. Este registro es voluntario y
        en cualquier momento puedo solicitar la actualización, rectificación,
        supresión de mis datos o la revocatoria de esta autorización, conforme a
        los canales indicados en la Política de Tratamiento de Datos Personales.
      </p>
    </span>
  </label>
  <p class="error" data-error-de="consentimiento" hidden></p>
</div>

<style>
  .campo--consentimiento {
    border-top: 1px solid var(--border-subtle);
    padding-top: var(--space-6);
  }
  .consentimiento {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-3);
    align-items: start;
    font-weight: var(--weight-regular);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--text-body);
    cursor: pointer;
  }
  .consentimiento input {
    width: 18px;
    height: 18px;
    margin-top: 2px;
    accent-color: var(--li-red);
  }
  /* El texto legal son dos párrafos, no una línea: sin esto se leen como un
     bloque único. Va un punto por debajo del cuerpo —es letra menuda— pero no
     más: sigue siendo lo que la persona está aceptando. */
  .consentimiento p {
    margin: 0 0 var(--space-3);
    font-size: var(--text-xs);
    line-height: var(--leading-relaxed);
  }
  .consentimiento p:last-child {
    margin-bottom: 0;
  }
  /* La advertencia concreta va al tamaño del cuerpo, no al de la letra menuda:
     es lo que de verdad sorprende a quien rellena el formulario. */
  .consentimiento .aviso {
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
  }
  .consentimiento a {
    color: var(--text-link);
  }

  /* El error lo pinta el script del formulario; aquí solo se le da forma. */
  .error {
    margin: var(--space-2) 0 0;
    font-size: var(--text-sm);
    color: var(--li-red);
  }
</style>
