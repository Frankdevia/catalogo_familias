---
import BaseLayout from '../layouts/BaseLayout.astro';
import FormularioNegocio from '../components/FormularioNegocio.astro';
import { SITIO } from '../data/sitio';

/*
 * Endpoint que recibe las solicitudes: la Edge Function `solicitud` de Supabase.
 *
 * Los tres formularios mandan al MISMO sitio y se distinguen por el campo
 * `cola`. Antes cada uno tenía su webhook de n8n; ahora la validación, el
 * límite por IP y la escritura viven en un solo lugar, con las mismas reglas
 * que usa el navegador —importadas del mismo archivo, no copiadas—.
 *
 * Va como valor por defecto y no como variable de despliegue porque las
 * "Variables de entorno" de EasyPanel son del contenedor en ejecución, no del
 * `docker build`: en un sitio estático nunca llegan.
 *
 * `||` y no `??`: Docker deja la variable como cadena vacía si el build arg no
 * se pasa, y `??` no atrapa la cadena vacía.
 */
const POR_DEFECTO =
  'https://mjxzbjrweqkuvshcpmwv.supabase.co/functions/v1/solicitud';

const endpoint = process.env.SOLICITUD_URL || POR_DEFECTO;
---

<BaseLayout
  title={`Inscribe tu negocio · ${SITIO.nombre}`}
  description="Postula el negocio de tu familia para que aparezca en el catálogo de la Fundación Liceo Inglés."
  noindex
>
  <section class="li-container">
    <p class="li-eyebrow">Familias FLI</p>
    <h1>Inscribe tu negocio</h1>
    <p class="entrada">
      Cuéntanos de tu negocio y lo publicamos en el catálogo para que toda la
      comunidad del Liceo Inglés pueda encontrarte. La inscripción es gratuita.
    </p>

    <FormularioNegocio endpoint={endpoint} />
  </section>
</BaseLayout>

<script>
  import '../scripts/registrar.ts';
</script>

<style>
  section {
    padding-block: var(--space-12) var(--space-20);
  }
  .li-eyebrow {
    margin: 0 0 var(--space-3);
  }
  h1 {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    letter-spacing: var(--tracking-display);
    text-transform: uppercase;
    color: var(--text-heading);
    margin: 0 0 var(--space-4);
  }
  .entrada {
    margin: 0 0 var(--space-12);
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: var(--text-body);
    max-width: 60ch;
  }
</style>
