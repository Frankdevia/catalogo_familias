---
/**
 * Panel de revisión.
 *
 * La página es estática y no trae ni un dato: es un armazón vacío. Todo lo
 * carga el navegador después de iniciar sesión, y quien decide qué se puede
 * leer es la base con sus políticas RLS, no este archivo. Aunque alguien abra
 * esta URL, sin sesión y sin estar en `administradores` no recibe una sola fila.
 *
 * Las credenciales de Supabase se hornean al construir y viajan en un atributo
 * `data-`, igual que el endpoint en `/registrar`: las "Variables de entorno" de
 * EasyPanel son del contenedor en ejecución, no del `docker build`, y en un
 * sitio estático nunca llegarían. La clave publicable es pública por diseño.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITIO } from '../data/sitio';

const supabaseUrl =
  process.env.SUPABASE_URL || 'https://mjxzbjrweqkuvshcpmwv.supabase.co';
const supabaseClave =
  process.env.SUPABASE_ANON_KEY || 'sb_publishable_Q3LLVvY_rKgZxyuC5SMAsw_6nfs5O0k';
---

<BaseLayout title={`Panel · ${SITIO.nombre}`} noindex>
  <main
    id="panel"
    class="li-container"
    data-supabase-url={supabaseUrl}
    data-supabase-clave={supabaseClave}
  >
    <!-- Mientras el script comprueba la sesión. Evita el parpadeo de enseñar
         la pantalla de entrar a quien ya está dentro. -->
    <section data-vista="cargando" class="centrado">
      <p class="cargando">Comprobando tu sesión…</p>
    </section>

    <section data-vista="entrar" class="centrado" hidden>
      <p class="li-eyebrow">Panel de revisión</p>
      <h1>Solicitudes de la comunidad</h1>
      <p class="entrada">
        Entra con tu cuenta del Liceo para revisar, publicar y retirar lo que
        envían las familias.
      </p>
      <button type="button" class="li-btn" data-accion="entrar">
        Entrar con Google
      </button>
      <p class="error" data-error hidden></p>
    </section>

    <section data-vista="sin-permiso" class="centrado" hidden>
      <p class="li-eyebrow">Sin acceso</p>
      <h1>Esta cuenta no puede revisar</h1>
      <p class="entrada">
        Entraste como <strong data-correo></strong>, pero esa cuenta no está
        autorizada para el panel. Si crees que debería estarlo, escríbenos a
        <a href={`mailto:${SITIO.contactEmail}`}>{SITIO.contactEmail}</a>.
      </p>
      <button type="button" class="secundario" data-accion="salir">
        Salir y probar con otra cuenta
      </button>
    </section>

    <section data-vista="panel" hidden>
      <header class="cabecera">
        <div>
          <p class="li-eyebrow">Panel de revisión</p>
          <h1>Solicitudes</h1>
        </div>
        <div class="quien">
          <span data-nombre></span>
          <button type="button" class="secundario" data-accion="salir">Salir</button>
        </div>
      </header>
      <nav class="pestanas" aria-label="Colas de revisión">
        <button type="button" data-cola="negocios" aria-pressed="true">
          Catálogo <span class="cuenta" data-cuenta="negocios">·</span>
        </button>
        <button type="button" data-cola="clasificados" aria-pressed="false">
          Clasificados <span class="cuenta" data-cuenta="clasificados">·</span>
        </button>
        <button type="button" data-cola="promociones" aria-pressed="false">
          Promociones <span class="cuenta" data-cuenta="promociones">·</span>
        </button>
      </nav>

      <div class="filtros" role="group" aria-label="Filtrar por estado">
        <button type="button" data-estado="pendiente" aria-pressed="true">Pendientes</button>
        <button type="button" data-estado="aprobado" aria-pressed="false">Publicados</button>
        <button type="button" data-estado="retirado" aria-pressed="false">Retirados</button>
        <button type="button" data-estado="rechazado" aria-pressed="false">Rechazados</button>
      </div>

      <div class="barra-acciones">
        <button type="button" class="li-btn" data-accion="nueva">Crear una entrada</button>
      </div>

      <p class="aviso" data-aviso hidden role="status" aria-live="polite"></p>

      <form data-formulario class="formulario" hidden></form>

      <div data-lista class="lista"></div>
    </section>
  </main>
</BaseLayout>

<script>
  import '../scripts/admin.ts';
</script>

<style>
  #panel {
    padding-block: var(--space-16);
    min-height: 60vh;
  }
  .centrado {
    max-width: 46ch;
    margin-inline: auto;
    text-align: center;
    padding-block: var(--space-16);
  }
  .centrado :global(.li-eyebrow) {
    display: block;
    margin-bottom: var(--space-3);
  }
  h1 {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    letter-spacing: var(--tracking-display);
    text-transform: uppercase;
    color: var(--text-heading);
    margin: 0 0 var(--space-4);
  }
  .entrada {
    margin: 0 0 var(--space-8);
    font-size: var(--text-base);
    color: var(--text-body);
  }
  .cargando {
    color: var(--li-gray-600);
    font-size: var(--text-base);
  }
  .cabecera {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-6);
    flex-wrap: wrap;
    margin-bottom: var(--space-8);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--border-subtle);
  }
  .cabecera h1 {
    margin: 0;
  }
  .quien {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    font-size: var(--text-sm);
    color: var(--text-body);
  }
  .secundario {
    font-family: var(--font-subhead);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    background: none;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-control);
    padding: 9px 16px;
    color: var(--text-heading);
    cursor: pointer;
  }
  .secundario:hover {
    border-color: var(--li-navy);
  }
  .error {
    margin-top: var(--space-4);
    color: var(--li-red);
    font-size: var(--text-sm);
  }

  /* --- colas y filtros --------------------------------------------------- */
  .pestanas,
  .filtros {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }
  .pestanas {
    border-bottom: 1px solid var(--border-subtle);
    margin-bottom: var(--space-6);
    gap: var(--space-6);
  }
  .pestanas button {
    background: none;
    border: none;
    border-bottom: 3px solid transparent;
    padding: 0 0 var(--space-3);
    font-family: var(--font-subhead);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--li-gray-600);
    cursor: pointer;
  }
  .pestanas button[aria-pressed='true'] {
    color: var(--text-heading);
    border-bottom-color: var(--li-red);
  }
  .pestanas .cuenta {
    font-weight: var(--weight-regular);
    opacity: 0.7;
  }
  .filtros {
    margin-bottom: var(--space-6);
  }
  .filtros button {
    font-family: var(--font-subhead);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    padding: 8px 14px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--li-gray-200);
    background: var(--li-white);
    color: var(--li-navy);
    cursor: pointer;
  }
  .filtros button[aria-pressed='true'] {
    background: var(--li-navy);
    border-color: var(--li-navy);
    color: var(--li-white);
  }

  .aviso {
    margin: 0 0 var(--space-6);
    padding: var(--space-4) var(--space-5);
    border-radius: var(--radius-card);
    background: var(--surface-subtle);
    border-left: 3px solid var(--li-navy);
    font-size: var(--text-sm);
    color: var(--text-body);
  }
  .aviso[data-tono='error'] {
    border-left-color: var(--li-red);
    color: var(--li-red);
  }

  .barra-acciones {
    display: flex;
    justify-content: flex-end;
    margin-bottom: var(--space-5);
  }

  /* --- formulario de crear y editar --------------------------------------- */
  .formulario {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4) var(--space-5);
    padding: var(--space-6);
    margin-bottom: var(--space-6);
    border: 1px solid var(--li-navy);
    border-radius: var(--radius-card);
    background: var(--surface-subtle);
  }
  .formulario :global(h2) {
    grid-column: 1 / -1;
    margin: 0;
    font-family: var(--font-subhead);
    font-size: var(--text-md);
    color: var(--text-heading);
  }
  .formulario :global(.campo) {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .formulario :global(.campo.ancho) {
    grid-column: 1 / -1;
  }
  .formulario :global(label) {
    font-family: var(--font-subhead);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    color: var(--text-heading);
  }
  .formulario :global(.interno) {
    color: var(--li-red);
    font-weight: var(--weight-regular);
    text-transform: uppercase;
    letter-spacing: var(--tracking-caps);
    font-size: var(--text-3xs);
  }
  .formulario :global(input),
  .formulario :global(select),
  .formulario :global(textarea) {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    padding: 9px 12px;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-control);
    background: var(--li-white);
    color: var(--text-body);
    width: 100%;
  }
  .formulario :global(textarea) {
    resize: vertical;
    min-height: 4.5em;
  }
  .formulario :global(.pie) {
    grid-column: 1 / -1;
    display: flex;
    gap: var(--space-3);
    align-items: center;
  }

  /* --- tarjetas de revisión ---------------------------------------------- */
  .lista {
    display: grid;
    gap: var(--space-5);
  }
  .lista :global(.vacio) {
    padding: var(--space-12);
    text-align: center;
    color: var(--li-gray-600);
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius-card);
  }
  .lista :global(.ficha) {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: var(--space-6);
    padding: var(--space-5);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-card);
    background: var(--surface-card);
    box-shadow: var(--shadow-md);
  }
  .lista :global(.ficha.sin-foto) {
    grid-template-columns: 1fr;
  }
  .lista :global(.ficha img) {
    width: 100%;
    aspect-ratio: 2.35 / 1;
    object-fit: cover;
    border-radius: var(--radius-card);
    background: var(--surface-subtle);
  }
  .lista :global(.ficha h2) {
    font-family: var(--font-subhead);
    font-size: var(--text-md);
    color: var(--text-heading);
    margin: 0 0 var(--space-2);
  }
  .lista :global(.etiqueta) {
    display: inline-block;
    font-family: var(--font-subhead);
    font-size: var(--text-3xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: var(--radius-pill);
    background: var(--li-navy);
    color: var(--li-white);
    margin-bottom: var(--space-3);
  }
  .lista :global(.desc) {
    margin: 0 0 var(--space-4);
    font-size: var(--text-sm);
    color: var(--text-body);
  }
  .lista :global(dl) {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-1) var(--space-4);
    margin: 0 0 var(--space-5);
    font-size: var(--text-sm);
  }
  .lista :global(dt) {
    font-weight: var(--weight-semibold);
    color: var(--li-gray-600);
  }
  .lista :global(dd) {
    margin: 0;
    color: var(--text-body);
  }
  /* Lo que nunca se publica se marca en la propia tarjeta, para que quien
     revisa vea de un vistazo qué es interno y qué va a salir al sitio. */
  .lista :global(dt.interno)::after {
    content: ' · no se publica';
    font-weight: var(--weight-regular);
    font-size: var(--text-3xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-caps);
    color: var(--li-red);
  }
  .lista :global(.acciones) {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
    align-items: center;
  }
  .lista :global(.acciones input) {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    padding: 8px 12px;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-control);
    width: 8ch;
  }
  .lista :global(.acciones button) {
    font-family: var(--font-subhead);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    padding: 9px 16px;
    border-radius: var(--radius-control);
    border: 1px solid var(--border-strong);
    background: var(--li-white);
    color: var(--text-heading);
    cursor: pointer;
  }
  .lista :global(.acciones button[data-accion='aprobar']) {
    background: var(--li-navy);
    border-color: var(--li-navy);
    color: var(--li-white);
  }
  .lista :global(.acciones button[data-accion='retirar']),
  .lista :global(.acciones button[data-accion='rechazar']) {
    color: var(--li-red);
    border-color: var(--li-red-300);
  }
  .lista :global(.acciones button:disabled) {
    opacity: 0.5;
    cursor: wait;
  }

  @media (max-width: 700px) {
    .lista :global(.ficha) {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    #panel {
      padding-block: var(--space-10);
    }
  }
</style>
