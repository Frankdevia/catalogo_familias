---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormularioPromocion from '../../components/FormularioPromocion.astro';
import { SITIO } from '../../data/sitio';

/*
 * Endpoint que recibe las solicitudes: la Edge Function `solicitud` de Supabase.
 *
 * Los tres formularios mandan al MISMO sitio y se distinguen por el campo
 * `cola`. Antes cada uno tenía su webhook de n8n; ahora la validación, el
 * límite por IP y la escritura viven en un solo lugar, con las mismas reglas
 * que usa el navegador —importadas del mismo archivo, no copiadas—.
 *
 * Va como valor por defecto y no como variable de despliegue porque las
 * "Variables de entorno" de EasyPanel son del contenedor en ejecución, no del
 * `docker build`: en un sitio estático nunca llegan.
 *
 * `||` y no `??`: Docker deja la variable como cadena vacía si el build arg no
 * se pasa, y `??` no atrapa la cadena vacía.
 */
const POR_DEFECTO =
  'https://mjxzbjrweqkuvshcpmwv.supabase.co/functions/v1/solicitud';

const endpoint = process.env.SOLICITUD_URL || POR_DEFECTO;
---

<BaseLayout
  title={`Publica tu promoción · ${SITIO.nombre}`}
  description="Ofrece un descuento o beneficio a las familias de la comunidad FLI."
  noindex
>
  <section class="li-container">
    <p class="li-eyebrow">Entre familias</p>
    <h1>Publica tu promoción</h1>
    <p class="entrada">
      Ofrece un descuento o un beneficio a las familias del Liceo Inglés. Se
      publica en la portada y se retira sola cuando venza.
    </p>

    <FormularioPromocion endpoint={endpoint} />
  </section>
</BaseLayout>

<script>
  import '../../scripts/promocion.ts';
</script>

<style>
  section {
    padding-block: var(--space-12) var(--space-20);
  }
  .li-eyebrow {
    margin: 0 0 var(--space-3);
  }
  h1 {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    letter-spacing: var(--tracking-display);
    text-transform: uppercase;
    color: var(--text-heading);
    margin: 0 0 var(--space-4);
  }
  .entrada {
    margin: 0 0 var(--space-12);
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: var(--text-body);
    max-width: 60ch;
  }
</style>
